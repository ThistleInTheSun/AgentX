# LLM（OpenAI 兼容 API，默认 DeepSeek；火山方舟等同理）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 微信公众号（可选：不填则只输出本地 Markdown 到 drafts/）
WECHAT_APPID=
WECHAT_APPSECRET=
# 草稿封面图 media_id：先执行 python run.py --upload-thumb cover.jpg 获取
WECHAT_THUMB_MEDIA_ID=
# 草稿显示的作者名
WECHAT_AUTHOR=好玩论文挖掘机
# 设为 1：写入草稿箱后自动发布到公众号主页（不推送粉丝；群发仍需手动）
WECHAT_AUTO_PUBLISH=0

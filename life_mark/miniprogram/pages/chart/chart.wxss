/* pages/chart/chart.wxss - 高端暗色 + 按天数缩放格子 */
.page-wrap-chart {
  height: 100vh;
}

.container {
  padding: 32rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: transparent;
}

.days-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(18, 18, 26, 0.78);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.days-options {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.day-option {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 400;
  padding: 20rpx;
  color: #6b6b6b;
  border-radius: 20rpx;
  transition: all 0.2s ease;
  border: 1rpx solid transparent;
}

.settings-link {
  font-size: 28rpx;
  font-weight: 400;
  color: #e8e4dc;
  padding: 12rpx 24rpx;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

.day-option.active {
  background: rgba(232, 228, 220, 0.1);
  color: #e8e4dc;
  border-color: rgba(255, 255, 255, 0.08);
  font-weight: 500;
}

.charts-container {
  flex: 1;
  min-height: 0;
  margin-bottom: 28rpx;
}

.charts-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.charts-empty-text {
  display: block;
  font-size: 32rpx;
  color: #e8e4dc;
  margin-bottom: 16rpx;
}

.charts-empty-hint {
  display: block;
  font-size: 26rpx;
  color: #6b6b6b;
}

.heatmap-scroll {
  width: 100%;
  margin-bottom: 24rpx;
}

.heatmap-scroll-inner {
  display: flex;
  justify-content: flex-start;
}

/* 90天：居中显示，内层至少占满视口以便内容居中 */
.heatmap-wrap.heatmap-days-90 .heatmap-scroll-inner {
  justify-content: center;
  min-width: 100%;
  width: 100%;
}

.heatmap-wrap.heatmap-days-90 .heatmap-inner {
  flex-shrink: 0;
  margin-left: 80rpx; /* 整体右移约 1.5~2 格（每格 28rpx） */
}

.heatmap-inner {
  display: inline-block;
}

.chart-section {
  background: rgba(18, 18, 26, 0.78);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.chart-title {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.chart-emoji {
  font-size: 32rpx;
  margin-right: 6rpx;
}

.chart-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #e8e4dc;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  letter-spacing: 0.5rpx;
}

.chart-count {
  font-size: 26rpx;
  color: #6b6b6b;
}

/* 月份行 - 与列宽一致（格子宽+间距）*/
.month-row {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  margin-bottom: 10rpx;
  justify-content: flex-start;
}

.month-col {
  width: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-label {
  font-size: 20rpx;
  color: #6b6b6b;
}

.heatmap {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
  justify-content: flex-start;
}

.heatmap-by-column {
  flex-wrap: nowrap;
  justify-content: flex-start;
  gap: 8rpx;
}

.heatmap-column {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.day-cell {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  position: relative;
  transition: all 0.25s;
}

.day-cell-empty {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background: transparent;
}

.day-cell.selected {
  transform: scale(1.2);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
  z-index: 1;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* 180天：缩小格子，保持圆角与间距比例 */
.heatmap-wrap.heatmap-days-180 .month-col {
  width: 28rpx;
}

.heatmap-wrap.heatmap-days-180 .month-label {
  font-size: 18rpx;
}

.heatmap-wrap.heatmap-days-180 .heatmap-column {
  gap: 8rpx;
}

.heatmap-wrap.heatmap-days-180 .day-cell,
.heatmap-wrap.heatmap-days-180 .day-cell-empty {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

.heatmap-wrap.heatmap-days-180 .month-row {
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.heatmap-wrap.heatmap-days-180 .heatmap-by-column {
  gap: 8rpx;
}

/* 365天：进一步缩小，保持圆角与间距 */
.heatmap-wrap.heatmap-days-365 .month-col {
  width: 18rpx;
}

.heatmap-wrap.heatmap-days-365 .month-label {
  font-size: 16rpx;
}

.heatmap-wrap.heatmap-days-365 .heatmap-column {
  gap: 6rpx;
}

.heatmap-wrap.heatmap-days-365 .day-cell,
.heatmap-wrap.heatmap-days-365 .day-cell-empty {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
}

.heatmap-wrap.heatmap-days-365 .month-row {
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.heatmap-wrap.heatmap-days-365 .heatmap-by-column {
  gap: 6rpx;
}

.heatmap-wrap.heatmap-days-365 .day-cell.selected {
  transform: scale(1.4);
}

.cell-tooltip {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(26, 26, 34, 0.92);
  color: #e8e4dc;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.day-cell:active .cell-tooltip {
  opacity: 1;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
}

.legend-four {
  flex-wrap: wrap;
  gap: 20rpx 28rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-color {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.legend-label {
  font-size: 24rpx;
  color: #6b6b6b;
}

.detail-card {
  background: rgba(18, 18, 26, 0.78);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.detail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #e8e4dc;
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.detail-label {
  font-size: 28rpx;
  font-weight: 400;
  color: #e8e4dc;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 500;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
}

.detail-value.level-0 {
  background: rgba(255, 255, 255, 0.06);
  color: #6b6b6b;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.detail-value.level-1 {
  background: rgba(232, 228, 220, 0.12);
  color: #c4beb4;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.detail-value.level-2 {
  background: rgba(232, 228, 220, 0.18);
  color: #e8e4dc;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.detail-value.level-3 {
  background: rgba(232, 228, 220, 0.22);
  color: #f0eeea;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.no-detail {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #6b6b6b;
  padding: 32rpx;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.export-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  background: rgba(26, 26, 34, 0.78);
  color: #e8e4dc;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.danger-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  background: transparent;
  color: #c4beb4;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}

.button-hover {
  opacity: 0.92;
  transform: scale(0.99);
}

/* 设置与编辑历史弹层 - 高端暗色 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 100;
}

.settings-panel {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 360rpx;
  background: rgba(18, 18, 26, 0.92);
  border-left: 1rpx solid rgba(255, 255, 255, 0.06);
  z-index: 101;
  padding: 48rpx 28rpx;
  box-shadow: -12rpx 0 40rpx rgba(0, 0, 0, 0.35);
  overflow-y: auto;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #e8e4dc;
  margin-bottom: 28rpx;
  padding-left: 12rpx;
  letter-spacing: 0.5rpx;
}

.settings-stats {
  margin-bottom: 32rpx;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.settings-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.settings-stat-row:last-child {
  border-bottom: none;
}

.settings-stat-label {
  font-size: 28rpx;
  color: #e8e4dc;
  flex: 1;
  min-width: 0;
}

.settings-stat-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #e8e4dc;
  margin-left: 24rpx;
}

.settings-section-title {
  font-size: 28rpx;
  color: #6b6b6b;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
}

.settings-category-list {
  margin-bottom: 20rpx;
}

.settings-category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.settings-category-name {
  font-size: 28rpx;
  color: #e8e4dc;
  flex: 1;
  min-width: 0;
}

.settings-category-delete {
  font-size: 26rpx;
  color: #f44336;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.settings-item-add {
  margin-bottom: 12rpx;
}

.settings-add-form {
  padding: 20rpx 0;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
}

.settings-add-input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #e8e4dc;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.settings-add-input:last-of-type {
  margin-bottom: 20rpx;
}

.settings-add-btns {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding: 0 24rpx;
}

.settings-add-btn {
  font-size: 28rpx;
  color: #6b6b6b;
  padding: 12rpx 24rpx;
}

.settings-add-btn.primary {
  color: #e8e4dc;
  font-weight: 500;
}

.settings-item {
  font-size: 30rpx;
  font-weight: 400;
  color: #e8e4dc;
  padding: 28rpx 28rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  letter-spacing: 0.5rpx;
}

.edit-panel {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 80vh;
  overflow-y: auto;
  background: rgba(18, 18, 26, 0.92);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  z-index: 101;
  padding: 40rpx 36rpx;
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.4);
}

.edit-panel-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #e8e4dc;
  margin-bottom: 32rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}

.edit-date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.edit-date-label {
  font-size: 28rpx;
  color: #6b6b6b;
}

.edit-date-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #e8e4dc;
}

.edit-categories {
  margin-bottom: 32rpx;
}

.edit-cat {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.edit-cat-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.edit-cat-emoji {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.edit-cat-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #e8e4dc;
  flex: 1;
  letter-spacing: 0.5rpx;
}

.edit-cat-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.edit-option-btn {
  flex: 0 0 calc(25% - 9rpx);
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  color: #6b6b6b;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.edit-option-btn.active {
  background: rgba(232, 228, 220, 0.12);
  color: #e8e4dc;
  border-color: rgba(255, 255, 255, 0.12);
}

.edit-save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  background: rgba(26, 26, 34, 0.78);
  color: #e8e4dc;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
